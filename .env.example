# AI Resonance: every environment variable the code reads. All optional.
#
# Nothing loads this file automatically. Copy it to .env (git-ignored), fill in what you need and export it before a
# command, e.g. in bash:  set -a; . ./.env; set +a; pnpm daily
# In GitHub Actions the same names are repository secrets / variables (see docs/DEPLOY.md §5).
# The web app never reads any of these: keys used in the browser live in the in-app credential vault.

# ── GitHub ─────────────────────────────────────────────────────────────────────────────────────────────────
# Raises GitHub's limits from 60 requests/hour to 1 000–5 000 (search, repo metadata, READMEs, lab GitHub strategies).
# Actions passes its built-in token. Locally a fine-grained token with no permissions is enough.
GITHUB_TOKEN=

# ── Pipeline LLM copy (pnpm daily): blurbs, "why it matters", essence points, daily and weekly briefs ────────────
# Any OpenAI-compatible endpoint. Empty key = items keep their source text and there is no brief.
RESONANCE_LLM_API_KEY=
# Defaults: config.yaml › enrich.baseUrl / enrich.model. Check your provider's current model ids.
RESONANCE_LLM_BASE_URL=
RESONANCE_LLM_MODEL=

# ── X (only with config.yaml › sources.x.enabled: true; pick the key of sources.x.provider) ────────────────────
# xapi: official pay-per-use API, about $20–30/month for the default watch list. Set a spending limit in console.x.com.
X_BEARER_TOKEN=
# xapi alternative to the bearer token (exchanged for an app-only token). daily.yml passes only X_BEARER_TOKEN.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# Unofficial, cheaper (about $3–10/month), may breach X's terms or disappear.
TWITTERAPI_IO_KEY=
SOCIALDATA_API_KEY=

# ── Reddit ─────────────────────────────────────────────────────────────────────────────────────────────────
# App-only OAuth with real votes and comment counts. Needs an app Reddit has approved. Empty = RSS mode.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Pipeline tests ─────────────────────────────────────────────────────────────────────────────────────────
# record = save every HTTP exchange under packages/pipeline/test/fixtures/http · replay = run offline from them.
# Same as `pnpm daily --fixtures record|replay`.
RESONANCE_FIXTURES=

# ── Site ───────────────────────────────────────────────────────────────────────────────────────────────────
# Public URL with a trailing slash (e-mail links, feeds, llms.txt, manifest). config.yaml › site.siteUrl wins when set.
# daily.yml derives https://<owner>.github.io/<repo>/ unless the SITE_URL repository variable is set.
SITE_URL=
# Vite base path for `pnpm build`. Default './' works on any host. daily.yml sets /<repo>/, or the BASE_PATH variable
# ("/" for a custom domain, Cloudflare Pages or a <owner>.github.io repository).
BASE_PATH=

# ── Agent channels (pnpm mcp, or node packages/channels/src/mcp.ts) ─────────────────────────────────────────
# One of these. RESONANCE_DIR wins when both are set. `pnpm mcp` runs inside packages/channels, so use an absolute
# path there (or ../web/public/api/v1).
RESONANCE_API=
RESONANCE_DIR=

# ── Scheduled e-mail (pnpm mail; in Actions: mail.yml) ─────────────────────────────────────────────────────
# Schedule as JSON with the keys of config.yaml › mail, e.g.
# {"enabled":true,"frequency":"daily","time":"08:30","timezone":"Asia/Shanghai","lang":"zh","preset":"qq"}
RESONANCE_MAIL=
# Recipients, comma-separated (a secret in Actions so it is masked in public logs).
MAIL_TO=
# SMTP: the full mailbox address and its SMTP code (QQ / 163 授权码, Gmail app password), not the login password.
SMTP_USER=
SMTP_PASS=
# Or Resend. Without a verified domain it sends from onboarding@resend.dev, only to your signup address.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
RESEND_FROM=
# Needed only when `pnpm mail` decides by itself (no --slot / --test / --dry-run): it reads and writes
# state/mail.json on the data branch and opens a `mail-failure` issue on errors. Actions sets both.
GITHUB_REPOSITORY=
# Branch holding state/mail.json (default: data).
DATA_BRANCH=
# config.yaml to read the mail defaults from (default: the repository root's config.yaml).
RESONANCE_CONFIG=
